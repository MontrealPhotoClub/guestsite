{
  "name": "montrealphotoclub",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:convex": "convex dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc -p convex --noEmit",
    "import:cio": "node --experimental-strip-types scripts/import-cio.ts",
    "format": "biome check --write .",
    "lint": "biome check .",
    "email:dev": "email dev --dir emails --port 3333",
    "email:build": "node scripts/build-login-email.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react-email": "6.11.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/rate-limiter": "^0.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.6",
    "convex": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
