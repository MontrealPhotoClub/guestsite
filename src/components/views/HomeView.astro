---
import BaseLayout from '../../layouts/BaseLayout.astro'
import EventList from '../EventList.astro'
import JoinCta from '../JoinCta.astro'
import { getEvents } from '../../lib/content'
import { t, url, type Locale } from '../../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const dict = t(locale)
const latest = (await getEvents(locale)).slice(0, 3)
---

<BaseLayout>
  <section class="hero">
    <h1>{dict.home.missionStatement}</h1>
  </section>

  <JoinCta locale={locale} />

  <section class="latest-events">
    <h2>{dict.home.latestEvents}</h2>
    <EventList locale={locale} events={latest} />
    <a href={url('events', locale)}>{dict.home.allEvents}</a>
  </section>

  <figure class="founder-word">
    <blockquote>
      <p>{dict.home.founderQuote}</p>
    </blockquote>
    <figcaption>
      {dict.home.founderName}, {dict.home.founderTitle}
    </figcaption>
  </figure>
</BaseLayout>
