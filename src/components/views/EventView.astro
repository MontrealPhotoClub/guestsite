---
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'
import { Image } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import JoinCta from '../JoinCta.astro'
import { formatDate, t, url, type Locale } from '../../i18n'

interface Props {
  locale: Locale
  event: CollectionEntry<'events'>
}

const { locale, event } = Astro.props
const dict = t(locale)
const { Content } = await render(event)
---

<BaseLayout
  title={event.data.title}
  description={event.data.excerpt}
  image={event.data.cover}
>
  <article class="event">
    <header>
      <p>
        <a href={url('events', locale)}>{dict.events.backToEvents}</a>
      </p>
      <h1>{event.data.title}</h1>
      <p>
        <time datetime={event.data.date.toISOString()}>
          {formatDate(event.data.date, locale)}
        </time>
        — {dict.events.by}
        {event.data.author}
      </p>
    </header>
    <Image
      src={event.data.cover}
      alt=""
      widths={[640, 1024, 1600, 2048]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="prose">
      <Content />
    </div>
  </article>

  <JoinCta locale={locale} />
</BaseLayout>
