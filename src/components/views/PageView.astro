---
import { render } from 'astro:content'
import { Image } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getPage } from '../../lib/content'
import type { Locale } from '../../i18n'

interface Props {
  locale: Locale
  /** File name in src/content/pages/<locale>/, without extension. */
  name: string
  hideStewardsBanner?: boolean
}

const { locale, name, hideStewardsBanner } = Astro.props
const page = await getPage(locale, name)
const { Content } = await render(page)
---

<BaseLayout
  title={page.data.title}
  description={page.data.excerpt}
  image={page.data.cover}
  hideStewardsBanner={hideStewardsBanner}
>
  <article class="page">
    <h1>{page.data.title}</h1>
    {page.data.cover && (
      <Image
        src={page.data.cover}
        alt=""
        widths={[640, 1024, 1600, 2048]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    )}
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
