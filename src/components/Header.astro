---
import {
  altLocaleUrl,
  otherLocale,
  htmlLang,
  t,
  url,
  type Locale,
} from '../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const dict = t(locale)
const alt = otherLocale(locale)
const links = [
  { href: url('about', locale), label: dict.nav.about },
  { href: url('events', locale), label: dict.nav.events },
  { href: url('contact', locale), label: dict.nav.contact },
  { href: url('profile', locale), label: dict.nav.profile },
]
---

<header class="site-header">
  <a class="site-logo" href={url('home', locale)}>
    <img src="/logo.svg" alt={dict.meta.siteName} width="277" height="34" />
  </a>
  <nav aria-label={dict.nav.label}>
    <ul>
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={
              Astro.url.pathname.startsWith(link.href) ? 'page' : undefined
            }
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href={altLocaleUrl(Astro.url.pathname)}
          hreflang={htmlLang[alt]}
          lang={htmlLang[alt]}
          aria-label={dict.nav.switchLanguageLabel}
        >
          {dict.nav.switchLanguage}
        </a>
      </li>
    </ul>
  </nav>
</header>
