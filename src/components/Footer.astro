---
import {
  altLocaleUrl,
  htmlLang,
  type Locale,
  otherLocale,
  t,
  url,
} from '../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const dict = t(locale)
const alt = otherLocale(locale)
---

<footer
  class="gutter flex flex-wrap justify-between gap-x-8 gap-y-4 border-t border-line pt-8 pb-10 text-[15px] text-muted"
>
  <p>
    {`© 2018–${new Date().getFullYear()} ${dict.meta.siteName} · ${dict.footer.madeIn}`}
  </p>
  <ul class="flex flex-wrap gap-x-6 gap-y-2">
    <li>
      <a href="https://instagram.com/montrealphotoclub" class="hover:text-ink">
        Instagram
      </a>
    </li>
    <li>
      <a href="mailto:contact@montrealphoto.club" class="hover:text-ink">
        {dict.footer.contact}
      </a>
    </li>
    <li>
      <a href={url('stewards', locale)} class="hover:text-ink">
        {dict.footer.stewards}
      </a>
    </li>
    <li>
      <a
        href={altLocaleUrl(Astro.url.pathname)}
        hreflang={htmlLang[alt]}
        lang={htmlLang[alt]}
        class="hover:text-ink"
      >
        {alt === 'en' ? 'English' : 'Français'}
      </a>
    </li>
  </ul>
</footer>
