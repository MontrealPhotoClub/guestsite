---
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import { entrySlug, eventUrl, formatDate, type Locale } from '../i18n'

interface Props {
  locale: Locale
  events: CollectionEntry<'events'>[]
}

const { locale, events } = Astro.props
---

<ul class="event-list">
  {events.map((event) => (
    <li>
      <article>
        <a href={eventUrl(entrySlug(event.id), locale)}>
          <Image
            src={event.data.cover}
            alt=""
            widths={[400, 800, 1200]}
            sizes="(min-width: 768px) 50vw, 100vw"
          />
          <h3>{event.data.title}</h3>
        </a>
        <p>
          <time datetime={event.data.date.toISOString()}>
            {formatDate(event.data.date, locale)}
          </time>
        </p>
        <p>{event.data.excerpt}</p>
      </article>
    </li>
  ))}
</ul>
