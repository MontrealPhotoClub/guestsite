---
import { Font, getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import '../styles/global.css'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import StewardsBanner from '../components/StewardsBanner.astro'
import { getLocale, htmlLang, locales, localeUrl, t } from '../i18n'

interface Props {
  title?: string
  description?: string
  image?: ImageMetadata
  /** Hide the stewards banner, e.g. on the stewards page itself. */
  hideStewardsBanner?: boolean
}

const { title, description, image, hideStewardsBanner = false } = Astro.props
const locale = getLocale(Astro.url.pathname)
const dict = t(locale)

const fullTitle = title
  ? `${title} | ${dict.meta.siteName}`
  : dict.meta.siteName
const metaDescription = description ?? dict.meta.description
const site = Astro.site ?? new URL('https://montrealphoto.club')
const canonical = new URL(Astro.url.pathname, site).href
const ogImage = image
  ? new URL(
      (
        await getImage({
          src: image,
          width: 1200,
          height: 630,
          fit: 'cover',
          format: 'jpg',
        })
      ).src,
      site
    ).href
  : new URL('/og-banner.jpg', site).href
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription}>
    <link rel="canonical" href={canonical}>
    {locales.map((l) => (
      <link
        rel="alternate"
        hreflang={htmlLang[l]}
        href={new URL(localeUrl(Astro.url.pathname, l), site).href}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localeUrl(Astro.url.pathname, 'fr'), site).href}
    >
    <link rel="icon" type="image/png" href="/favicon.png">
    <meta name="theme-color" content="#f4f4f1">
    <Font cssVariable="--font-schibsted" preload />
    <Font cssVariable="--font-newsreader" />
    <link rel="sitemap" href="/sitemap-index.xml">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content={dict.meta.siteName}>
    <meta property="og:locale" content={htmlLang[locale].replace('-', '_')}>
    <meta property="og:title" content={title ?? dict.meta.siteName}>
    <meta property="og:description" content={metaDescription}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={ogImage}>
    <meta name="twitter:card" content="summary_large_image">

    {umamiId && (
      <script
        is:inline
        defer
        src="https://analytics.jpvalery.com/script.js"
        data-website-id={umamiId}
      />
    )}
  </head>
  <body class="flex min-h-dvh flex-col">
    <a class="skip-link" href="#content">
      {dict.nav.skipToContent}
    </a>
    {!hideStewardsBanner && <StewardsBanner locale={locale} />}
    <Header locale={locale} />
    <main id="content" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
