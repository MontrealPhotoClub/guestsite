# ─── Astro (local .env.local, and Vercel project settings) ───────────────────

# Convex deployment URL. `npx convex dev` writes CONVEX_URL to .env.local;
# copy it here with the PUBLIC_ prefix so the profile island can read it.
# On Vercel, `npx convex deploy --cmd-url-env-var-name PUBLIC_CONVEX_URL` sets it.
PUBLIC_CONVEX_URL=

# Umami website id (analytics.jpvalery.com). Leave empty to disable analytics.
PUBLIC_UMAMI_WEBSITE_ID=

# Vercel only: lets the build deploy Convex functions to production.
# CONVEX_DEPLOY_KEY=

# ─── Convex (set with `npx convex env set NAME value`, or the dashboard) ─────
# These are NOT read from this file. Listed here for reference.

# Convex Auth. `npx @convex-dev/auth` generates the keys (see README).
# SITE_URL=https://montrealphoto.club        (http://localhost:4321 in dev)
# JWT_PRIVATE_KEY=...
# JWKS=...

# Customer.io Track API (Settings → Workspace settings → API credentials).
# CIO_SITE_ID=
# CIO_TRACK_API_KEY=

# Customer.io App API key and the transactional message for login codes.
# CIO_LOGIN_MESSAGE_ID accepts the numeric id or the trigger name.
# CIO_APP_API_KEY=
# CIO_LOGIN_MESSAGE_ID=

# Customer.io reporting webhook signing key.
# CIO_WEBHOOK_SIGNING_KEY=

# EU workspaces only.
# CIO_TRACK_URL=https://track-eu.customer.io
# CIO_APP_URL=https://api-eu.customer.io

# Dev only: print login codes in the Convex logs instead of sending them.
# Never set this in production.
# LOG_LOGIN_CODES=true
